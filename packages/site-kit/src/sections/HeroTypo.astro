---
/**
 * Hero « typo » : pas de photo. Grand titre sur fond teinté texturé (motif signature), mot géant en contour
 * en arrière-plan, et une « fiche » de contact sombre à droite (téléphone, horaires, adresse, note).
 * À préférer quand aucune photo n'est assez bonne : un hero photo médiocre est pire qu'un hero typographique.
 */
import type { SectionDe } from "../schema.ts";
import { site, tel, theme } from "../lib/site.ts";
import { horairesFr } from "../lib/format.ts";
import { motif } from "../lib/signatures.ts";
import Surtitre from "../components/Surtitre.astro";
import TitreHero from "../components/TitreHero.astro";
import BoutonsHero from "../components/BoutonsHero.astro";
import NoteGoogle from "../components/NoteGoogle.astro";
import Icone from "../components/Icone.astro";
interface Props {
  section: SectionDe<"hero">;
}
const { contenu: c } = Astro.props.section;
const e = site.entreprise;
const horaires = horairesFr(e.horaires);
const m = motif(theme.signature, theme.couleurs.encre, 0.1);
---

<section id="haut" aria-labelledby="haut-titre" class="fond-teinte relative isolate overflow-hidden">
  <div aria-hidden="true" class="absolute inset-0 -z-20" style={`background-image:${m.image};background-size:${m.taille}`}></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-linear-to-br from-teinte via-teinte/70 to-teinte/10"></div>
  {
    c.motSignature && (
      <p
        aria-hidden="true"
        class="contour pointer-events-none absolute -right-6 bottom-0 -z-10 hidden translate-y-[30%] lg:block font-titres text-[8rem] leading-none whitespace-nowrap select-none sm:text-[12rem] lg:text-[16rem]"
        style="--contour: color-mix(in oklab, var(--c-encre), transparent 80%)"
      >
        {c.motSignature}
      </p>
    )
  }
  <div class="conteneur grid gap-12 pt-12 pb-20 md:pt-20 md:pb-28 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16 lg:pt-28 lg:pb-44 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <div>
      <Surtitre texte={c.surtitre} />
      <TitreHero
        titre={c.titre}
        accent={c.titreAccent}
        class="mt-5 text-[2.625rem] leading-[1.02] sm:text-[3.75rem] lg:text-[4.75rem] xl:text-[5.25rem]"
      />
      <p class="intro texte-doux mt-7 text-lg! md:text-xl!">{c.sousTitre}</p>
      <BoutonsHero contenu={c} class="mt-9" />
    </div>
    <aside aria-label="Coordonnées" class="sur-sombre rounded-ui-l bg-sombre p-7 text-sur-sombre shadow-[0_24px_60px_-28px_rgb(0_0_0/0.45)]">
      <p class="text-sm font-semibold tracking-[0.14em] text-accent-sur-sombre uppercase">Ligne directe</p>
      <a href={tel.lien} class="mt-3 block font-titres text-[2rem] leading-tight text-sur-sombre tabular-nums no-underline hover:text-accent-sur-sombre">
        {tel.affiche}
      </a>
      <dl class="mt-6 space-y-4 border-t border-white/12 pt-6 text-[0.9375rem]">
        {
          horaires.length > 0 && (
            <div class="flex gap-3">
              <dt class="sr-only">Horaires</dt>
              <Icone nom="clock" class="mt-1 size-[1.125rem] shrink-0 text-accent-sur-sombre" />
              <dd class="space-y-1">
                {horaires.map((h) => (
                  <p>
                    <span class="font-medium">{h.jours}</span>
                    <br />
                    <span class="text-sur-sombre-doux">{h.heures}</span>
                  </p>
                ))}
              </dd>
            </div>
          )
        }
        <div class="flex gap-3">
          <dt class="sr-only">Adresse</dt>
          <Icone nom="map-pin" class="mt-1 size-[1.125rem] shrink-0 text-accent-sur-sombre" />
          <dd class="text-sur-sombre-doux">{e.adresse.rue}<br />{e.adresse.codePostal} {e.adresse.commune}</dd>
        </div>
      </dl>
      {e.noteGoogle && <NoteGoogle clair class="mt-5" />}
    </aside>
  </div>
</section>
