{
  "name": "liverdian",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "npm run build && node apps/hub/src/main.ts",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @liverdian/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "essai:claude": "node apps/hub/scripts/essai-claude.ts",
    "captures": "node apps/hub/scripts/captures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
