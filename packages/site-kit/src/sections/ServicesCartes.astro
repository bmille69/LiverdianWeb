---
/**
 * Services « cartes » : titre et intro dans une colonne collante à gauche, cartes 2 colonnes à droite
 * (icône, numéro, titre, texte). Pour 4 à 8 prestations.
 */
import type { SectionDe } from "../schema.ts";
import type { Fond } from "../lib/site.ts";
import { ancre, ancreDevis, libelleDevis } from "../lib/site.ts";
import Section from "../components/Section.astro";
import TitreSection from "../components/TitreSection.astro";
import Icone from "../components/Icone.astro";
interface Props {
  section: SectionDe<"services">;
  fond: Fond;
}
const { section, fond } = Astro.props;
const c = section.contenu;
const id = ancre(section);
const sombre = fond === "sombre";
---

<Section id={id} fond={fond}>
  <div class="conteneur grid gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <TitreSection id={id} surtitre={c.surtitre} titre={c.titre} intro={c.intro} />
      <a href={ancreDevis} class="lien mt-8 inline-flex min-h-11 items-center gap-2">
        {libelleDevis}
        <Icone nom="arrow-right" class="size-4" />
      </a>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 sm:gap-5">
      {
        c.items.map((it, i) => (
          <li
            class:list={[
              "group relative flex flex-col rounded-ui-l border p-5 transition-colors duration-200 sm:p-7",
              sombre ? "border-white/10 bg-sombre-surface" : "border-trait bg-surface hover:border-encre/25",
            ]}
          >
            <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-start">
              <span class:list={["grid size-11 place-items-center rounded-ui sm:size-12", sombre ? "bg-accent-sur-sombre/15 text-accent-sur-sombre" : "bg-teinte text-accent-texte"]}>
                <Icone nom={it.icone ?? "check"} class="size-6" />
              </span>
              <h3 class="text-xl sm:order-last sm:col-span-3 sm:mt-6 sm:text-[1.375rem]">{it.titre}</h3>
              <span aria-hidden="true" class="texte-doux hidden justify-self-end font-titres text-sm tabular-nums sm:col-start-3 sm:row-start-1 sm:inline">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="texte-doux mt-3 text-[0.9875rem] leading-relaxed">{it.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
