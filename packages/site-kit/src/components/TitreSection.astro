---
/** Surtitre + H2 + intro, avec l'id lu par aria-labelledby de la section. */
import Surtitre from "./Surtitre.astro";
interface Props {
  id: string;
  surtitre?: string;
  titre: string;
  intro?: string;
  centre?: boolean;
  class?: string;
}
const { id, surtitre, titre, intro, centre = false, class: classe = "" } = Astro.props;
---

<div class:list={[centre ? "mx-auto max-w-3xl text-center" : "max-w-3xl", classe]}>
  <Surtitre texte={surtitre} class={centre ? "justify-center" : ""} />
  <h2 id={`${id}-titre`} class:list={["titre-section", surtitre && "mt-4"]}>{titre}</h2>
  {intro && <p class:list={["intro texte-doux mt-5", centre && "mx-auto"]}>{intro}</p>}
  <slot />
</div>
