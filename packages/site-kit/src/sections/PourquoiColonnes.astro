---
/**
 * Pourquoi nous « colonnes » : 2 à 4 arguments vérifiables côte à côte, filet d'accent au-dessus de chacun.
 * Sobre ; convient après une section services chargée.
 */
import type { SectionDe } from "../schema.ts";
import type { Fond } from "../lib/site.ts";
import { ancre } from "../lib/site.ts";
import Section from "../components/Section.astro";
import TitreSection from "../components/TitreSection.astro";
import Icone from "../components/Icone.astro";
interface Props {
  section: SectionDe<"pourquoi">;
  fond: Fond;
}
const { section, fond } = Astro.props;
const c = section.contenu;
const id = ancre(section);
const n = c.items.length;
---

<Section id={id} fond={fond} texture>
  <div class="conteneur">
    <TitreSection id={id} surtitre={c.surtitre} titre={c.titre} intro={c.intro} />
    <ul class:list={["mt-12 grid gap-10 sm:grid-cols-2 md:mt-16 lg:gap-12", n === 3 && "lg:grid-cols-3", n === 4 && "lg:grid-cols-4"]}>
      {
        c.items.map((it) => (
          <li class="border-t-2 border-current/10 pt-6">
            <div class="flex items-center gap-3">
              <Icone nom={it.icone ?? "check"} class="size-6 texte-accent" />
              <h3 class="text-xl md:text-[1.375rem]">{it.titre}</h3>
            </div>
            <p class="texte-doux mt-3 leading-relaxed">{it.texte}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
