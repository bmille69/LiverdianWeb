---
/**
 * Pied de page. Variantes :
 * - « complet » : fond sombre, 4 colonnes (identité, coordonnées, horaires, zone) + ligne légale.
 * - « sobre » : fond teinté, deux lignes compactes (pour les pages déjà denses).
 * Toujours : téléphone répété, adresse, SIREN, mentions légales, confidentialité.
 */
import { site, tel, fonds, ancreDevis, libelleDevis } from "../lib/site.ts";
import { horairesFr, sirenFr } from "../lib/format.ts";
import Icone from "../components/Icone.astro";
import Logo from "./Logo.astro";
const e = site.entreprise;
const horaires = horairesFr(e.horaires);
const communes = [site.zone.commune, ...site.zone.voisines].map((c) => c.nom);
const annee = new Date().getFullYear();
// Si la dernière section est déjà sombre, le pied complet passe en teinté pour garder la séparation.
const sombre = site.pied.variante === "complet" && fonds[fonds.length - 1] !== "sombre";
---

{
  site.pied.variante === "complet" ? (
    <footer class:list={[sombre ? "fond-sombre sur-sombre" : "fond-teinte border-t border-trait", "pt-16 pb-8 md:pt-20"]}>
      <div class="conteneur">
        <div class:list={["grid gap-12 md:grid-cols-2 lg:gap-10", horaires.length || e.horairesNote ? "lg:grid-cols-[1.4fr_1fr_1fr_1fr]" : "lg:grid-cols-[1.4fr_1fr_1fr]"]}>
          <div class="max-w-sm">
            <Logo clair={sombre} />
            {site.pied.phrase && <p class="texte-doux mt-5 text-[0.9375rem]">{site.pied.phrase}</p>}
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={tel.lien} class="btn btn-primaire"><Icone nom="phone" /> {tel.affiche}</a>
            </div>
          </div>
          <div>
            <h2 class="font-corps text-sm font-semibold uppercase tracking-[0.12em] texte-accent">Coordonnées</h2>
            <address class="mt-4 space-y-2 text-[0.9375rem] not-italic">
              <p>{e.adresse.rue}<br />{e.adresse.codePostal} {e.adresse.commune}</p>
              <p><a href={tel.lien} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">{tel.affiche}</a></p>
              {e.email && <p><a href={`mailto:${e.email}`} class="inline-flex min-h-11 items-center break-all underline-offset-4 hover:underline">{e.email}</a></p>}
            </address>
          </div>
          {/* Sans horaires dans les sources, la colonne disparaît : rien d'inventé, pas de doublon avec « Coordonnées ». */}
          {(horaires.length > 0 || e.horairesNote) && (
            <div>
              <h2 class="font-corps text-sm font-semibold uppercase tracking-[0.12em] texte-accent">Horaires</h2>
              {horaires.length > 0 && (
                <dl class="mt-4 space-y-3 text-[0.9375rem]">
                  {horaires.map((h) => (
                    <div>
                      <dt class="font-medium">{h.jours}</dt>
                      <dd class="texte-doux">{h.heures}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {e.horairesNote && <p class="texte-doux mt-3 text-sm">{e.horairesNote}</p>}
            </div>
          )}
          <div>
            <h2 class="font-corps text-sm font-semibold uppercase tracking-[0.12em] texte-accent">Zone d’intervention</h2>
            <p class="texte-doux mt-4 text-[0.9375rem] leading-relaxed">{communes.join(" · ")}</p>
            <a href={ancreDevis} class="lien mt-4 inline-flex min-h-11 items-center gap-1.5 text-[0.9375rem]">
              {libelleDevis} <Icone nom="arrow-right" class="size-4" />
            </a>
          </div>
        </div>
        <div class:list={["mt-14 flex flex-col gap-4 border-t pt-6 text-sm md:flex-row md:items-center md:justify-between", sombre ? "border-white/12" : "border-trait"]}>
          <p class="texte-doux">
            © {annee} {e.raisonSociale}{e.siren && ` · SIREN ${sirenFr(e.siren)}`}
          </p>
          <ul class="flex flex-wrap gap-x-6 gap-y-1">
            <li><a href="/mentions-legales/" class="texte-doux inline-flex min-h-11 items-center underline-offset-4 hover:underline">Mentions légales</a></li>
            <li><a href="/confidentialite/" class="texte-doux inline-flex min-h-11 items-center underline-offset-4 hover:underline">Confidentialité</a></li>
            <li>
              <a href={site.demo.agenceUrl ?? "https://liverdian.fr"} class="texte-doux inline-flex min-h-11 items-center underline-offset-4 hover:underline">
                Site réalisé par {site.demo.agence}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  ) : (
    <footer class:list={[fonds[fonds.length - 1] === "teinte" ? "fond-surface" : "fond-teinte", "border-t border-trait py-10"]}>
      <div class="conteneur flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div>
          <Logo />
          <address class="texte-doux mt-4 text-[0.9375rem] not-italic">
            {e.adresse.rue}, {e.adresse.codePostal} {e.adresse.commune}
            <br />
            <a href={tel.lien} class="inline-flex min-h-11 items-center font-semibold text-encre underline-offset-4 hover:underline">{tel.affiche}</a>
            {e.email && <> · <a href={`mailto:${e.email}`} class="underline-offset-4 hover:underline">{e.email}</a></>}
          </address>
          {horaires.length > 0 && <p class="texte-doux text-[0.9375rem]">{horaires.map((h) => `${h.jours} : ${h.heures}`).join(" · ")}</p>}
        </div>
        <div class="text-sm md:text-right">
          <ul class="flex flex-wrap gap-x-6 md:justify-end">
            <li><a href="/mentions-legales/" class="texte-doux inline-flex min-h-11 items-center underline-offset-4 hover:underline">Mentions légales</a></li>
            <li><a href="/confidentialite/" class="texte-doux inline-flex min-h-11 items-center underline-offset-4 hover:underline">Confidentialité</a></li>
          </ul>
          <p class="texte-doux">© {annee} {e.raisonSociale}{e.siren && ` · SIREN ${sirenFr(e.siren)}`} · Site réalisé par {site.demo.agence}</p>
        </div>
      </div>
    </footer>
  )
}
