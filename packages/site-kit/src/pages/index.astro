---
/**
 * Page d'accueil : les sections de site.json, dans l'ordre, avec la variante demandée.
 * Composant d'une section : `src/sections/<Famille><Variante>.astro` (ex. hero + panorama → HeroPanorama.astro) ;
 * élément sur mesure : `src/sections/custom/<composant>.astro`, codé pour ce site par l'Intégrateur.
 */
import Base from "../layouts/Base.astro";
import { site, fonds } from "../lib/site.ts";
import { titreAccueil } from "../lib/seo.ts";

const modules = import.meta.glob<{ default: any }>("../sections/*.astro", { eager: true });
const surMesure = import.meta.glob<{ default: any }>("../sections/custom/*.astro", { eager: true });
const capitale = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

function composant(s: (typeof site.sections)[number]) {
  if (s.type === "surmesure") {
    const m = surMesure[`../sections/custom/${s.composant}.astro`];
    if (!m) throw new Error(`Élément sur mesure « ${s.composant} » introuvable : créer src/sections/custom/${s.composant}.astro`);
    return m.default;
  }
  const nom = `${capitale(s.type)}${capitale(s.variante)}`;
  const m = modules[`../sections/${nom}.astro`];
  if (!m) throw new Error(`Section « ${s.type} : ${s.variante} » sans composant (src/sections/${nom}.astro)`);
  return m.default;
}
---

<Base titre={titreAccueil()} description={site.seo.description} chemin="/" accueil>
  {
    site.sections.map((section, i) => {
      const Composant = composant(section);
      return <Composant section={section} fond={fonds[i]} />;
    })
  }
</Base>
