---
/**
 * Cadre d'image : équerres (technique), décalé (aplat de couleur derrière), arche (haut cintré), liseré (contour
 * décalé), coin (bloc d'accent dans un angle), simple. Par défaut celui de la signature, sauf si `theme.mise.cadre`
 * l'impose. Le contenu (une <Picture>) remplit le cadre ; le traitement d'image (`mise.images`) s'applique via `.media`.
 */
import { theme } from "../lib/site.ts";
import { cadre, type TypeCadre } from "../lib/signatures.ts";
interface Props {
  class?: string;
  sombre?: boolean;
  type?: TypeCadre;
}
const choix = theme.mise.cadre === "auto" ? cadre(theme.signature) : theme.mise.cadre;
const { class: classe = "", sombre = false, type = choix } = Astro.props;
const accent = sombre ? "text-accent-sur-sombre" : "text-accent-texte";
---

<div class:list={["relative", classe, type === "decale" && "pr-3 pb-3 sm:pr-5 sm:pb-5", type === "lisere" && "pt-3 pl-3 sm:pt-4 sm:pl-4"]}>
  {
    type === "decale" && (
      <div aria-hidden="true" class:list={["absolute inset-0 top-5 left-5 rounded-ui-l sm:top-8 sm:left-8", sombre ? "bg-accent-sur-sombre/25" : "bg-accent/20"]} />
    )
  }
  {
    type === "lisere" && (
      <div aria-hidden="true" class:list={["absolute inset-0 right-3 bottom-3 rounded-ui-l border-2 border-current sm:right-4 sm:bottom-4", accent]} />
    )
  }
  {
    type === "coin" && (
      <div aria-hidden="true" class:list={["absolute -top-3 -right-3 size-24 sm:-top-4 sm:-right-4 sm:size-32", sombre ? "bg-accent-sur-sombre" : "bg-accent"]} />
    )
  }
  <div class:list={["media relative h-full overflow-hidden", type === "arche" ? "rounded-t-[999px] rounded-b-ui" : "rounded-ui-l"]}>
    <slot />
  </div>
  {
    type === "equerres" && (
      <div aria-hidden="true" class:list={["pointer-events-none absolute -inset-2.5 sm:-inset-3.5", accent]}>
        <span class="absolute top-0 left-0 h-6 w-6 border-t-2 border-l-2 border-current" />
        <span class="absolute top-0 right-0 h-6 w-6 border-t-2 border-r-2 border-current" />
        <span class="absolute bottom-0 left-0 h-6 w-6 border-b-2 border-l-2 border-current" />
        <span class="absolute right-0 bottom-0 h-6 w-6 border-r-2 border-b-2 border-current" />
      </div>
    )
  }
</div>
