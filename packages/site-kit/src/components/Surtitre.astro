---
/** Surtitre de section avec le marqueur de la signature du thème. */
import { theme } from "../lib/site.ts";
interface Props {
  texte?: string;
  class?: string;
}
const { texte, class: classe = "" } = Astro.props;
const sig = theme.signature;
---

{
  texte && (
    <p class:list={["flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.14em] texte-accent", classe]}>
      <span aria-hidden="true" class="inline-flex shrink-0">
        {sig === "faisceau" && (
          <svg width="22" height="10" viewBox="0 0 22 10" fill="none">
            <path d="M0 5h14" stroke="currentColor" stroke-width="1.5" />
            <rect x="15" y="1" width="6" height="8" fill="currentColor" />
          </svg>
        )}
        {sig === "onde" && (
          <svg width="26" height="10" viewBox="0 0 26 10" fill="none">
            <path d="M1 5c3-4 6-4 8 0s5 4 8 0 5-4 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        )}
        {sig === "isobares" && (
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5" />
            <circle cx="7" cy="7" r="2.5" fill="currentColor" />
          </svg>
        )}
        {sig === "tuiles" && (
          <svg width="24" height="10" viewBox="0 0 24 10" fill="none">
            <path d="M1 9a5.5 5.5 0 0 1 11 0M12 9a5.5 5.5 0 0 1 11 0" stroke="currentColor" stroke-width="1.75" />
          </svg>
        )}
        {sig === "veinage" && (
          <svg width="26" height="10" viewBox="0 0 26 10" fill="none">
            <path d="M1 3c6-2 10 2 16 0s6-1 8 0M1 7c5-1 9 2 14 0s7-1 10 0" stroke="currentColor" stroke-width="1.25" />
          </svg>
        )}
        {sig === "aplat" && (
          <svg width="22" height="12" viewBox="0 0 22 12" fill="none">
            <rect width="10" height="12" fill="currentColor" />
            <rect x="12" width="10" height="12" fill="currentColor" opacity=".45" />
          </svg>
        )}
      </span>
      <span>{texte}</span>
    </p>
  )
}
