---
/** Gabarit des pages légales : titre, date, texte en colonne de lecture. */
import Base from "./Base.astro";
import { titrePage } from "../lib/seo.ts";
import { demo } from "../lib/site.ts";
interface Props {
  titre: string;
  description: string;
  chemin: string;
}
const { titre, description, chemin } = Astro.props;
---

<Base titre={titrePage(titre)} description={description} chemin={chemin}>
  <section aria-labelledby="haut-titre" class="fond-teinte border-b border-trait">
    <div class="conteneur py-14 md:py-20">
      <p><a href="/" class="lien inline-flex min-h-11 items-center">← Retour à l’accueil</a></p>
      <h1 id="haut-titre" class="mt-4 text-[2.5rem] md:text-[3.5rem]">{titre}</h1>
      {
        demo && (
          <p class="texte-doux mt-4 max-w-2xl">
            Page d’une maquette : elle reprend les données publiques de l’entreprise (répertoire Sirene) et sera complétée avant toute
            mise en ligne officielle.
          </p>
        )
      }
    </div>
  </section>
  <div class="conteneur py-14 md:py-20">
    <div class="legal max-w-prose">
      <slot />
    </div>
  </div>
</Base>

<style is:global>
  .legal h2 {
    font-size: 1.5rem;
    margin-top: 2.75rem;
  }
  .legal h2:first-child {
    margin-top: 0;
  }
  .legal p,
  .legal ul,
  .legal dl {
    margin-top: 0.875rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal li + li {
    margin-top: 0.375rem;
  }
  .legal dt {
    font-weight: 600;
    margin-top: 0.75rem;
  }
  .legal a {
    color: var(--c-accent-texte);
    text-decoration: underline;
  }
</style>
